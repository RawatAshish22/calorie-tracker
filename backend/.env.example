PORT=8787
AI_PROVIDER=auto

# Google Gemini (recommended for vision + text)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cloudflare Workers AI (free, separate text and vision models)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# OpenRouter (free tier available)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

CACHE_TTL_HOURS=168
VISION_SCAN_INTERVAL_MS=4500
